{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "declaration": false,
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "prisma.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
