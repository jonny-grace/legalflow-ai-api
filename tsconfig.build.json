{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "ES2021",
    "sourceMap": false,
    "declaration": false,
    "removeComments": true
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
